# GoHighLevel (GHL) LeadConnector API — used by /api/lead to upsert contacts.
# Create a Private Integration / API key in GHL and copy your Location ID.
# These are SERVER-ONLY secrets. Never prefix them with NEXT_PUBLIC_.
GHL_API_KEY=
GHL_LOCATION_ID=

# GoHighLevel (GHL) webhook URLs — paste each from your GHL workflow triggers.
# Forms degrade gracefully and still show success if a webhook is left blank.
GHL_CONTACT_WEBHOOK=
GHL_GET_STARTED_WEBHOOK=
GHL_GUIDE_OPTIN_WEBHOOK=
GHL_NEWSLETTER_WEBHOOK=
GHL_SECOND_OPINION_WEBHOOK=
GHL_REALTOR_WEBHOOK=

# Analytics (optional — scripts only load when set)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXXXXXXXXX
